project_id     = "replace-with-project-id"
project_number = "replace-with-project-number"
environment    = "dev"
region         = "us-central1"
zone           = "us-central1-a"
platform_name  = "event-management"

terraform_deployer_email = "terraform-deployer@PROJECT_ID.iam.gserviceaccount.com"

terraform_deployer_project_roles = [
  "roles/artifactregistry.admin",
  "roles/cloudbuild.admin",
  "roles/cloudbuild.builds.editor",
  "roles/compute.networkAdmin",
  "roles/compute.securityAdmin",
  "roles/iam.serviceAccountAdmin",
  "roles/iam.serviceAccountUser",
  "roles/resourcemanager.projectIamAdmin",
  "roles/secretmanager.admin",
  "roles/storage.admin",
]


# Networking
network_name         = "event-management-dev-vpc"
network_routing_mode = "REGIONAL"

network_subnets = {
  management = {
    name                  = "event-management-dev-management"
    description           = "Management subnet for Event Management DEV"
    ip_cidr_range         = "10.10.0.0/24"
    region                = "us-central1"
    private_google_access = true
    stack_type            = "IPV4_ONLY"
  }

  workloads = {
    name                  = "event-management-dev-workloads"
    description           = "Application workloads subnet for Event Management DEV"
    ip_cidr_range         = "10.20.0.0/24"
    region                = "us-central1"
    private_google_access = true
    stack_type            = "IPV4_ONLY"
  }

  data = {
    name                  = "event-management-dev-data"
    description           = "Data services subnet for Event Management DEV"
    ip_cidr_range         = "10.30.0.0/24"
    region                = "us-central1"
    private_google_access = true
    stack_type            = "IPV4_ONLY"
  }
}

enable_internal_firewall = true
enable_management_ssh    = true

# Artifact Registry
artifact_registry_location       = "us-central1"
artifact_registry_repository_id  = "event-management-dev-containers"
artifact_registry_description    = "Docker images for Event Management dev."
artifact_registry_immutable_tags = false

# Cloud Storage
cloud_storage_buckets = {
  application = {
    name    = "PROJECT_ID-event-management-dev-application"
    purpose = "application"
  }

  logs = {
    name               = "PROJECT_ID-event-management-dev-logs"
    purpose            = "logs"
    versioning_enabled = false
  }

  backups = {
    name    = "PROJECT_ID-event-management-dev-backups"
    purpose = "backups"
  }

  shared = {
    name    = "PROJECT_ID-event-management-dev-shared"
    purpose = "shared"
  }
}


# OS_08_11_SECRET_MANAGER_TFVARS
# Terraform administra contenedores y metadatos, no payloads.
secret_manager_secrets = {
  database_credentials = {
    secret_id        = "event-management-dev-database-credentials"
    purpose          = "database-credentials"
    replication_type    = "AUTOMATIC"
    deletion_protection = true

    labels = {
      component = "postgresql"
    }

    iam = {}
  }

  servicenow_credentials = {
    secret_id        = "event-management-dev-servicenow-credentials"
    purpose          = "servicenow-integration"
    replication_type    = "AUTOMATIC"
    deletion_protection = true

    labels = {
      component = "integration-worker"
    }

    iam = {}
  }

  notification_credentials = {
    secret_id        = "event-management-dev-notification-credentials"
    purpose          = "notification-integration"
    replication_type    = "AUTOMATIC"
    deletion_protection = true

    labels = {
      component = "integration-worker"
    }

    iam = {}
  }

  automation_credentials = {
    secret_id        = "event-management-dev-automation-credentials"
    purpose          = "automation-integration"
    replication_type    = "AUTOMATIC"
    deletion_protection = true

    labels = {
      component = "automation-engine"
    }

    iam = {}
  }
}
# END_OS_08_11_SECRET_MANAGER_TFVARS


# OS_08_12_CLOUD_BUILD_TFVARS
cloud_build_execution_service_account = {
  account_id      = "cloud-build-executor"
  display_name    = "Cloud Build Executor"
  description     = "Dedicated Cloud Build execution identity for Event Management."
  deletion_policy = "PREVENT"
}

cloud_build_execution_project_roles = [
  "roles/logging.logWriter",
]

cloud_build_secret_access = []

cloud_build_repository_connection = {
  enabled = false
}

cloud_build_repositories = {}
cloud_build_triggers     = {}
# END_OS_08_12_CLOUD_BUILD_TFVARS
