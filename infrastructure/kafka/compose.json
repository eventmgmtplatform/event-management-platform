{
  "services": {
    "kafka": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "CLUSTER_ID": "${KAFKA_CLUSTER_ID:?required}",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:${KAFKA_HOST_PORT:?required}",
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka:9093",
        "KAFKA_DEFAULT_REPLICATION_FACTOR": "1",
        "KAFKA_DELETE_TOPIC_ENABLE": "true",
        "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS": "0",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "PLAINTEXT",
        "KAFKA_LISTENERS": "PLAINTEXT://0.0.0.0:29092,PLAINTEXT_HOST://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT",
        "KAFKA_LOG_DIRS": "/var/lib/kafka/data",
        "KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS": "300000",
        "KAFKA_LOG_RETENTION_HOURS": "168",
        "KAFKA_LOG_SEGMENT_BYTES": "1073741824",
        "KAFKA_MIN_INSYNC_REPLICAS": "1",
        "KAFKA_NODE_ID": "1",
        "KAFKA_NUM_PARTITIONS": "3",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1"
      },
      "hostname": "kafka",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:29092 --list >/dev/null 2>&1 || exit 1"
        ],
        "timeout": "10s",
        "interval": "10s",
        "retries": 15,
        "start_period": "30s"
      },
      "image": "${KAFKA_IMAGE:?required}",
      "ports": [
        "127.0.0.1:${KAFKA_HOST_PORT:?required}:9092"
      ],
      "restart": "unless-stopped",
      "volumes": [
        "kafka-data:/var/lib/kafka/data"
      ],
      "platform": "linux/amd64",
      "networks": [
        "event-management-net"
      ]
    },
    "kafka-init": {
      "command": null,
      "depends_on": {
        "kafka": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/bash",
        "/opt/event-management/create-topics.sh"
      ],
      "image": "${KAFKA_IMAGE:?required}",
      "restart": "no",
      "volumes": [
        "./create-topics.sh:/opt/event-management/create-topics.sh:ro"
      ],
      "platform": "linux/amd64",
      "networks": [
        "event-management-net"
      ]
    },
    "kafka-ui": {
      "command": null,
      "depends_on": {
        "kafka": {
          "condition": "service_healthy",
          "required": true
        },
        "kafka-init": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_TYPE": "DISABLED",
        "DYNAMIC_CONFIG_ENABLED": "false",
        "KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS": "kafka:29092",
        "KAFKA_CLUSTERS_0_NAME": "${KAFKA_UI_CLUSTER_NAME:?required}",
        "MANAGEMENT_HEALTH_LDAP_ENABLED": "false",
        "SWAGGER_UI_ENABLED": "true"
      },
      "hostname": "kafka-ui",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://127.0.0.1:8080/actuator/health || exit 1"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 12,
        "start_period": "20s"
      },
      "image": "${KAFKA_UI_IMAGE:?required}",
      "ports": [
        "127.0.0.1:${KAFKA_UI_PORT:?required}:8080"
      ],
      "restart": "unless-stopped",
      "platform": "linux/amd64",
      "networks": [
        "event-management-net"
      ]
    }
  },
  "volumes": {
    "kafka-data": {
      "labels": {"org.eventmanagement.kafka.cluster-id": "${KAFKA_CLUSTER_ID:?required}"}
    }
  },
  "networks": {
    "event-management-net": {}
  }
}
