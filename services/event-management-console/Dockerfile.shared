FROM node:22-alpine AS console-build
WORKDIR /console
COPY event-management-console/package.json event-management-console/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY event-management-console/tsconfig*.json event-management-console/vite.config.ts event-management-console/index.html ./
COPY event-management-console/src ./src
RUN npm run build

FROM node:22-alpine AS dashboards-build
WORKDIR /dashboards
COPY oem-dashboards/package.json oem-dashboards/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY oem-dashboards/tsconfig*.json oem-dashboards/vite.config.ts oem-dashboards/index.html ./
COPY oem-dashboards/src ./src
RUN npm run build

FROM nginx:1.27-alpine
COPY event-management-console/nginx.conf /etc/nginx/conf.d/default.conf
COPY oem-dashboards/nginx.conf /etc/nginx/conf.d/dashboards.conf
COPY --from=console-build /console/dist /usr/share/nginx/html
COPY --from=dashboards-build /dashboards/dist /usr/share/nginx/dashboards
EXPOSE 8080 8091
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health && wget -q -O /dev/null http://127.0.0.1:8091/health || exit 1
