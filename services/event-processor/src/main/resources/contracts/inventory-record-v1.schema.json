{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-management:inventory-record-v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "enabled",
    "priority",
    "scope",
    "metadata",
    "type",
    "facts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer"
    },
    "scope": {
      "type": "object",
      "properties": {
        "customerCode": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "nodeAlias": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "instanceId": {
          "type": "string"
        },
        "monitoringSolution": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "owner"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "type": {
      "const": "INVENTORY"
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 7
    }
  },
  "additionalProperties": false
}
