<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="state-request-route">
        <from uri="kafka:{{kafka.topic.state.requested}}?brokers={{kafka.bootstrap.servers}}&amp;groupId={{kafka.consumer.group.id}}-lifecycle&amp;autoOffsetReset=earliest&amp;autoCommitEnable=false&amp;allowManualCommit=true&amp;breakOnFirstError=true"/>
        <process ref="stateRequestProcessor"/>
    </route>
</routes>
