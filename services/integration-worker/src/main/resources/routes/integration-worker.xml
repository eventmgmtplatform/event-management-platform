<?xml version="1.0" encoding="UTF-8"?>

<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- =====================================================
         INTEGRATION COMMAND CONSUMER
         ===================================================== -->

    <route id="integration-command-consumer">

        <from uri="kafka:{{kafka.topic.integration.commands}}?brokers={{kafka.bootstrap.servers}}&amp;groupId={{kafka.consumer.group.id}}&amp;autoOffsetReset={{kafka.consumer.auto.offset.reset}}&amp;sessionTimeoutMs={{kafka.consumer.session-timeout-ms}}&amp;heartbeatIntervalMs={{kafka.consumer.heartbeat-interval-ms}}"/>

        <log loggingLevel="INFO"
             message="Comando recibido desde integration.commands"/>

        <doTry>

            <!--
                Valida el comando y genera el cuerpo HTTP
                para ServiceNow.
            -->
            <process ref="integrationCommandProcessor"/>

            <!--
                Reserve commandId before any external side effect.
            -->
            <process ref="integrationCommandClaimProcessor"/>

            <choice>

                <!--
                    Another execution already owns this command.
                    Stop without invoking ServiceNow or publishing
                    a competing terminal result.
                -->
                <when>
                    <simple>${exchangeProperty.integrationIdempotencyDecision} == 'IN_PROGRESS'</simple>

                    <log loggingLevel="INFO"
                         message="Comando duplicado en progreso suprimido: commandId=${exchangeProperty.commandId}"/>

                    <stop/>
                </when>

                <!--
                    The command already completed. The claim processor
                    placed its stored terminal result in the message body.
                -->
                <when>
                    <simple>${exchangeProperty.integrationIdempotencyDecision} == 'REPLAY'</simple>

                    <log loggingLevel="INFO"
                         message="Reutilizando resultado idempotente: commandId=${exchangeProperty.commandId}"/>
                </when>

                <!--
                    This execution acquired the durable command claim.
                -->
                <otherwise>

                    <!--
                        Remove inherited Kafka headers before invoking
                        the external ServiceNow endpoint.
                    -->
                    <removeHeaders pattern="*"/>

                    <setHeader name="Content-Type">
                        <constant>application/json</constant>
                    </setHeader>

                    <setHeader name="CamelHttpMethod">
                        <constant>POST</constant>
                    </setHeader>

                    <log loggingLevel="INFO"
                         message="Invocando ServiceNow Mock para eventId=${exchangeProperty.eventId}"/>

                    <!--
                        Executes the ServiceNow request with classified,
                        bounded retries. Only the final outcome continues.
                    -->
                    <process ref="serviceNowRetryExecutor"/>

                    <process ref="integrationResultProcessor"/>

                </otherwise>

            </choice>

            <doCatch>

                <exception>java.lang.Exception</exception>

                <process ref="integrationFailureProcessor"/>

            </doCatch>

        </doTry>

        <!--
            Persist the owned terminal result before Kafka publication.
            REPLAY and unresolved claims are intentionally ignored.
        -->
        <process ref="integrationCommandCompletionProcessor"/>

        <!--
            Tanto SUCCESS como FAILED se publican
            en integration.results.
        -->
        <removeHeaders pattern="*"/>

        <!--
            KafkaConstants.KEY is assigned through Java after header cleanup.
            This preserves ordering by the logical event identity.
        -->
        <process ref="integrationKafkaKeyProcessor"/>

        <to uri="kafka:{{kafka.topic.integration.results}}?brokers={{kafka.bootstrap.servers}}"/>

        <log loggingLevel="INFO"
             message="Resultado publicado: commandId=${exchangeProperty.commandId}, eventId=${exchangeProperty.eventId}"/>

    </route>

</routes>
