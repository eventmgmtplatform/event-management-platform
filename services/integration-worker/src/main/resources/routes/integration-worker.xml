<?xml version="1.0" encoding="UTF-8"?>

<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- =====================================================
         INTEGRATION COMMAND CONSUMER
         ===================================================== -->

    <route id="integration-command-consumer" autoStartup="false">

        <from uri="kafka:{{kafka.topic.integration.commands}}?brokers={{kafka.bootstrap.servers}}&amp;groupId={{kafka.consumer.group.id}}&amp;autoOffsetReset={{kafka.consumer.auto.offset.reset}}&amp;sessionTimeoutMs={{kafka.consumer.session-timeout-ms}}&amp;heartbeatIntervalMs={{kafka.consumer.heartbeat-interval-ms}}"/>

        <to uri="direct:integration-command-core"/>

    </route>

    <route id="integration-command-core">

        <from uri="direct:integration-command-core"/>

        <log loggingLevel="INFO"
             message="Comando recibido desde integration.commands"/>

        <doTry>

            <!--
                Valida el comando y genera el cuerpo HTTP
                para ServiceNow.
            -->
            <process ref="integrationCommandProcessor"/>

            <!--
                Resolve provider before acquiring a durable command claim.
                GNM is recognized by the worker but intentionally cannot
                execute an external side effect in GNM-01B.
            -->
            <process ref="integrationProviderRouter"/>

            <choice>

                <when>
                    <simple>${exchangeProperty.integrationProvider} == 'GLPI'</simple>
                    <process ref="glpiCommandProcessor"/>
                    <process ref="integrationCommandClaimProcessor"/>
                    <choice>
                        <when><simple>${exchangeProperty.integrationIdempotencyDecision} == 'IN_PROGRESS'</simple><stop/></when>
                        <when><simple>${exchangeProperty.integrationIdempotencyDecision} == 'REPLAY'</simple></when>
                        <otherwise><process ref="glpiExecutionProcessor"/></otherwise>
                    </choice>
                </when>
                <when>
                    <simple>${exchangeProperty.integrationProvider} == 'CACF'</simple>
                    <!-- CACF has its own durable-admission consumer group on this topic. -->
                    <stop/>
                </when>

                <when>
                    <simple>${exchangeProperty.integrationProvider} == 'SERVICENOW' &amp;&amp; ${exchangeProperty.operation} == 'APPLY_AUTOMATION_RESULT'</simple>
                    <process ref="integrationCommandClaimProcessor"/>
                    <choice>
                        <when>
                            <simple>${exchangeProperty.integrationIdempotencyDecision} == 'IN_PROGRESS'</simple>
                            <!-- Never repeat a potentially accepted work-note mutation. -->
                            <stop/>
                        </when>
                        <when>
                            <simple>${exchangeProperty.integrationIdempotencyDecision} == 'REPLAY'</simple>
                        </when>
                        <otherwise>
                            <process ref="serviceNowAutomationActionProcessor"/>
                            <process ref="integrationResultProcessor"/>
                        </otherwise>
                    </choice>
                </when>

                <when>
                    <simple>${exchangeProperty.integrationProvider} == 'SERVICENOW' &amp;&amp; ${exchangeProperty.operation} == 'RESOLVE_TICKET'</simple>
                    <process ref="integrationCommandClaimProcessor"/>
                    <choice>
                        <when><simple>${exchangeProperty.integrationIdempotencyDecision} == 'IN_PROGRESS'</simple><stop/></when>
                        <when><simple>${exchangeProperty.integrationIdempotencyDecision} == 'REPLAY'</simple></when>
                        <otherwise><process ref="serviceNowResolveProcessor"/><process ref="integrationResultProcessor"/></otherwise>
                    </choice>
                </when>

                <when>
                    <simple>${exchangeProperty.integrationProvider} == 'GNM'</simple>

                    <!--
                        Validate the provider-neutral GNM command contract.
                        Everbridge mapping and transport are deliberately absent
                        from this checkpoint.
                    -->
                    <process ref="gnmCommandProcessor"/>

                    <!--
                        Acquire the same durable command claim used by the
                        certified integration execution model before any
                        provider mutation.
                    -->
                    <process ref="integrationCommandClaimProcessor"/>

                    <choice>

                        <!--
                            A concurrent execution already owns the command.
                            GNM transport MUST NOT execute.
                        -->
                        <when>
                            <simple>${exchangeProperty.integrationIdempotencyDecision} == 'IN_PROGRESS'</simple>

                            <log loggingLevel="INFO"
                                 message="GNM duplicate in progress suppressed: commandId=${exchangeProperty.commandId}"/>

                            <stop/>
                        </when>

                        <!--
                            An expired/ambiguous GNM claim cannot blindly
                            relaunch an Everbridge incident.

                            GNM-03D will provide provider-state reconciliation.
                        -->
                        <when>
    <simple>${exchangeProperty.integrationIdempotencyDecision} == 'RECONCILE'</simple>

    <log loggingLevel="WARN"
         message="GNM durable reconciliation executing GET only; POST Launch suppressed: commandId=${exchangeProperty.commandId}"/>

    <process ref="gnmReconciliationProcessor"/>

    <choice>
        <when>
            <simple>${exchangeProperty.gnmReconciliationOutcome} == 'OPEN_CONFIRMED' || ${exchangeProperty.gnmReconciliationOutcome} == 'CLOSED_CONFIRMED'</simple>

            <log loggingLevel="INFO"
                 message="GNM durable reconciliation confirmed OPEN: commandId=${exchangeProperty.commandId}"/>
        </when>

        <otherwise>
            <log loggingLevel="WARN"
                 message="GNM durable reconciliation unresolved; no provider mutation and no terminal completion: commandId=${exchangeProperty.commandId}"/>

            <stop/>
        </otherwise>
    </choice>
</when>

                        <!--
                            Stored terminal result is already in the message
                            body. Never invoke GNM transport during replay.
                        -->
                        <when>
                            <simple>${exchangeProperty.integrationIdempotencyDecision} == 'REPLAY'</simple>

                            <log loggingLevel="INFO"
                                 message="GNM idempotent result replay: commandId=${exchangeProperty.commandId}"/>
                        </when>

                        <!--
                            EXECUTE is the only decision allowed to mutate the
                            provider.
                        -->
                        <otherwise>

                            <log loggingLevel="INFO"
                                 message="GNM Launch executing against configured local provider: commandId=${exchangeProperty.commandId}"/>

                            <choice>
                                <when>
                                    <simple>${exchangeProperty.operation} == 'CLOSE_NOTIFICATION'</simple>

                                    <log loggingLevel="INFO"
                                         message="GNM CLOSE executing against configured provider: commandId=${exchangeProperty.commandId}"/>

                                    <process ref="gnmCloseExecutionProcessor"/>

                                    <!--
                                        CLOSE is a single provider mutation.

                                        SUCCESS follows the certified
                                        CLOSE_ACCEPTED -> durable checkpoint ->
                                        authoritative GET path.

                                        RECONCILIATION_REQUIRED means the provider
                                        mutation outcome is ambiguous (including
                                        duplicate Close HTTP 400). Never send a
                                        second PUT; reconcile through GET only.
                                    -->
                                    <choice>
                                        <when>
                                            <simple>${exchangeProperty.gnmCloseExecutionOutcome} == 'RECONCILIATION_REQUIRED'</simple>

                                            <process ref="gnmDuplicateCloseReconciliationProcessor"/>
                                        </when>

                                        <otherwise>
                                            <process ref="gnmCloseResultProcessor"/>

                                            <!--
                                                Durable provider checkpoint MUST be persisted
                                                immediately after provider acceptance and before
                                                authoritative GET confirmation.
                                            -->
                                            <process ref="gnmProviderCheckpointProcessor"/>

                                            <process ref="gnmClosedConfirmationProcessor"/>
                                        </otherwise>
                                    </choice>

                                </when>

                                <otherwise>

                                    <process ref="gnmLaunchExecutionProcessor"/>
                                    <process ref="gnmLaunchResultProcessor"/>
                                    <process ref="gnmProviderCheckpointProcessor"/>
                                    <process ref="gnmOpenConfirmationProcessor"/>

                                </otherwise>
                            </choice>

                        </otherwise>

                    </choice>
                </when>

                <otherwise>

                    <!--
                        Preserve the certified ServiceNow payload contract.
                    -->
                    <process ref="serviceNowCommandProcessor"/>

                    <!--
                        Reserve commandId before any external side effect.
                    -->
                    <process ref="integrationCommandClaimProcessor"/>

                    <choice>

                <!--
                    Another execution already owns this command.
                    Stop without invoking ServiceNow or publishing
                    a competing terminal result.
                -->
                <when>
                    <simple>${exchangeProperty.integrationIdempotencyDecision} == 'IN_PROGRESS'</simple>

                    <log loggingLevel="INFO"
                         message="Comando duplicado en progreso suprimido: commandId=${exchangeProperty.commandId}"/>

                    <stop/>
                </when>

                <!--
                    An expired claim is never blindly created again. First
                    reconcile by the durable ServiceNow event identity.
                -->
                <when>
                    <simple>${exchangeProperty.integrationIdempotencyDecision} == 'RECONCILE'</simple>

                    <process ref="serviceNowReconciliationProcessor"/>

                    <choice>
                        <when>
                            <simple>${exchangeProperty.serviceNowReconciliationOutcome} == 'FOUND'</simple>

                            <process ref="integrationResultProcessor"/>
                        </when>
                        <when>
                            <simple>${exchangeProperty.serviceNowReconciliationOutcome} == 'NOT_FOUND_CONFIRMED'</simple>

                            <removeHeaders pattern="*"/>

                            <setHeader name="Content-Type">
                                <constant>application/json</constant>
                            </setHeader>

                            <setHeader name="CamelHttpMethod">
                                <constant>POST</constant>
                            </setHeader>

                            <log loggingLevel="WARN"
                                 message="Reconciliación confirmó ausencia; creando ticket: commandId=${exchangeProperty.commandId}"/>

                            <process ref="serviceNowRetryExecutor"/>
                            <process ref="integrationResultProcessor"/>
                        </when>
                        <when>
                            <simple>${exchangeProperty.serviceNowReconciliationOutcome} == 'RETRY_LATER'</simple>

                            <log loggingLevel="WARN"
                                 message="Reconciliación diferida sin CREATE ni resultado terminal: commandId=${exchangeProperty.commandId}"/>

                            <stop/>
                        </when>
                        <otherwise>
                            <log loggingLevel="ERROR"
                                 message="Resultado de reconciliación no resuelto; flujo detenido: commandId=${exchangeProperty.commandId}"/>

                            <stop/>
                        </otherwise>
                    </choice>
                </when>

                <!--
                    The command already completed. The claim processor
                    placed its stored terminal result in the message body.
                -->
                <when>
                    <simple>${exchangeProperty.integrationIdempotencyDecision} == 'REPLAY'</simple>

                    <log loggingLevel="INFO"
                         message="Reutilizando resultado idempotente: commandId=${exchangeProperty.commandId}"/>
                </when>

                <!--
                    This execution acquired the durable command claim.
                -->
                <otherwise>

                    <!--
                        Remove inherited Kafka headers before invoking
                        the external ServiceNow endpoint.
                    -->
                    <removeHeaders pattern="*"/>

                    <setHeader name="Content-Type">
                        <constant>application/json</constant>
                    </setHeader>

                    <setHeader name="CamelHttpMethod">
                        <constant>POST</constant>
                    </setHeader>

                    <log loggingLevel="INFO"
                         message="Invocando ServiceNow Mock para eventId=${exchangeProperty.eventId}"/>

                    <!--
                        Executes the ServiceNow request with classified,
                        bounded retries. Only the final outcome continues.
                    -->
                    <process ref="serviceNowRetryExecutor"/>

                    <process ref="integrationResultProcessor"/>

                </otherwise>

                    </choice>

                </otherwise>

            </choice>

            <doCatch>

                <exception>java.lang.Exception</exception>

                <process ref="integrationFailureProcessor"/>

            </doCatch>

        </doTry>

        <!--
            Persist the owned terminal result before Kafka publication.
            REPLAY and unresolved claims are intentionally ignored.
        -->
        <process ref="gnmResultEnvelopeProcessor"/>
        <process ref="integrationCommandCompletionProcessor"/>

        <!--
            Tanto SUCCESS como FAILED se publican
            en integration.results.
        -->
        <removeHeaders pattern="*"/>

        <!--
            KafkaConstants.KEY is assigned through Java after header cleanup.
            This preserves ordering by the logical event identity.
        -->
        <!--
            Normalize the terminal payload before crossing the Kafka boundary.
            integration.results uses StringSerializer; provider processors may
            legitimately leave the body as a Jackson JsonNode.
        -->
        <process ref="integrationKafkaPayloadProcessor"/>

        <process ref="integrationKafkaKeyProcessor"/>

        <to uri="kafka:{{kafka.topic.integration.results}}?brokers={{kafka.bootstrap.servers}}"/>

        <log loggingLevel="INFO"
             message="Resultado publicado: commandId=${exchangeProperty.commandId}, eventId=${exchangeProperty.eventId}"/>



    </route>

</routes>
