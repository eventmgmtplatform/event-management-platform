OEM_DASHBOARD_CONFIG=/tmp/oem-dashboards/config.json
# Credentials supplied only in the server environment; never in VITE_* variables.
OEM_POSTGRES_DSN=postgresql://oem_dashboard_login:CHANGE_ME@127.0.0.1:5432/event_management
# Base URL; the adapter appends /api/dashboards/<domain>.
OEM_INTERNAL_API_URL=http://127.0.0.1:8093
OEM_INTERNAL_API_TOKEN=
