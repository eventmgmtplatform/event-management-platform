{
  "request": {
    "method": "POST",
    "urlPath": "/tupix/api/v1/netcool/tickets",
    "headers": {"Content-Type": {"contains": "text/xml"}, "Authorization": {"matches": "Basic .+"}},
    "bodyPatterns": [{"matchesXPath": "//*[local-name()='TransactionName' and text()='CREATE']"}, {"matchesXPath": "//*[local-name()='RequesterID']"}]
  },
  "response": {"status": 200, "headers": {"Content-Type": "text/xml"}, "body": "<Response><StatusCode>0</StatusCode><Acknowledge>true</Acknowledge><Comment>Submitted; awaiting asynchronous acknowledgement</Comment></Response>"}
}
